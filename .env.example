# HTTP 服务
PORT=8787
HOST=127.0.0.1

# 用于加密数据库密码和飞书凭据（至少 32 个字符；生产环境请使用密钥管理服务）
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# 可选：默认数据文件位置
DATA_FILE=.data/store.json

# 可选：飞书 API 地址（自建环境可覆盖）
FEISHU_BASE_URL=https://open.feishu.cn

# 管理 API 令牌（生产环境必填；请求头：Authorization: Bearer <ADMIN_TOKEN>）
ADMIN_TOKEN=replace-with-another-long-random-secret
